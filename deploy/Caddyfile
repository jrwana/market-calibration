# HTTPS is automatic (Let's Encrypt). The app lives only under /APP_PATH/; the root and any other
# path return 404, so finding the server's address reveals nothing.
{$APP_HOST} {
	encode gzip

	# Ask search engines not to index anything, even if the link is posted somewhere public.
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}

	handle /robots.txt {
		respond `User-agent: *
Disallow: /
` 200
	}

	redir /{$APP_PATH} /{$APP_PATH}/ 308

	handle /{$APP_PATH}/* {
		reverse_proxy app:8501
	}

	# Routes for other apps on this server, each under its own unlisted path. The snippets are
	# written on the server by those projects' deploy scripts, so their paths stay out of git.
	import /etc/caddy/sites/*.caddy

	handle {
		respond 404
	}
}
